# Resend (https://resend.com) — required for /api/contact
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Promonet <hello@promonetconsulting.com>

# Where contact form submissions are delivered
CONTACT_TO=hello@promonetconsulting.com

# Recommended: 301 every other hostname (www, platform preview domains) to this one
# CANONICAL_HOST=promonetconsulting.com

# PORT=8080

# Build-time (must be available to `npm run build`). Leave unset to emit nothing.
# Google Analytics 4 measurement ID (GA4 admin → Data streams → Web)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Search Console "HTML tag" verification token (the content="..." value;
# pasting the whole <meta> tag also works)
# VITE_GSC_VERIFICATION=
